{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "groups"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "groups": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["resourceGroup", "status", "resources"],
        "properties": {
          "resourceGroup": { "type": "string", "minLength": 1 },
          "status": { "enum": ["Completed", "Partial", "Failed"] },
          "resources": {
            "type": "array", "maxItems": 10000,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["resourceId", "kind", "planId", "sku", "instances", "metrics"],
              "properties": {
                "resourceId": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["Consumption", "Standard"] },
                "planId": { "type": ["string", "null"] },
                "sku": { "type": ["string", "null"], "maxLength": 128 },
                "instances": { "type": ["integer", "null"], "minimum": 0 },
                "metrics": {
                  "type": "array", "maxItems": 2,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["name", "unit", "interval", "expectedPoints", "status", "points"],
                    "properties": {
                      "name": { "enum": ["BillableActionExecutions", "BillableTriggerExecutions", "CpuPercentage"] },
                      "unit": { "enum": ["Count", "Percent"] },
                      "interval": { "enum": ["PT1H", "P1D"] },
                      "expectedPoints": { "type": "integer", "minimum": 1 },
                      "status": { "enum": ["Completed", "Partial", "Failed"] },
                      "points": {
                        "type": "array", "maxItems": 100000,
                        "items": {
                          "type": "object", "additionalProperties": false,
                          "required": ["timestamp", "average", "maximum", "total"],
                          "properties": {
                            "timestamp": { "type": "string", "format": "date-time" },
                            "average": { "type": ["number", "null"], "minimum": 0 },
                            "maximum": { "type": ["number", "null"], "minimum": 0 },
                            "total": { "type": ["number", "null"], "minimum": 0 }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
