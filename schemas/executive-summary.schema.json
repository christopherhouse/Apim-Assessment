{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/apim-assessment/schemas/executive-summary.schema.json",
  "title": "APIM Model-Safe Executive Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "posture", "confidence", "priorities", "themes",
    "decisions", "roadmap", "assumptions", "dataGaps"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "posture": { "enum": ["ActionRequired", "ImprovementRecommended", "InsufficientEvidence"] },
    "confidence": { "$ref": "#/definitions/confidence" },
    "priorities": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/definitions/item" }
    },
    "themes": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/definitions/item" }
    },
    "decisions": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/definitions/item" }
    },
    "roadmap": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/definitions/item" }
    },
    "assumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "CloudflareAssumed", "OriginAuthenticationUnverified",
          "OwnerIntentUnverified", "TelemetryUnavailable", "CostUnavailable"
        ]
      }
    },
    "dataGaps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "CollectionIncomplete", "PolicyIncomplete", "NetworkIncomplete",
          "DiagnosticsIncomplete", "UsageUnavailable", "CostUnavailable",
          "OriginAuthenticationUnknown", "OwnerIntentUnknown",
          "BackendMappingUnavailable", "ProductClassificationUnavailable",
          "DefenderUnavailable", "RbacUnavailable", "GitUnavailable"
        ]
      }
    }
  },
  "definitions": {
    "confidence": { "enum": ["High", "Medium", "Low"] },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "code", "confidence", "findingRefs", "factRefs", "observationRefs"],
      "properties": {
        "itemId": {
          "type": "string",
          "pattern": "^(?:priority|theme|decision|roadmap)-(?=[0-9]*[1-9])[0-9]{3,6}(?![\\s\\S])"
        },
        "code": {
          "enum": [
            "ReduceExposure", "StrengthenAuthentication", "ProtectSecrets",
            "ImproveTls", "ImproveDiagnostics", "ImproveReliability",
            "ImproveGovernance", "ValidateAssumptions", "ResolveDataGaps",
            "ReviewUsage", "ReviewCost"
          ]
        },
        "confidence": { "$ref": "#/definitions/confidence" },
        "findingRefs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^finding-(?=[0-9]*[1-9])[0-9]{6}(?![\\s\\S])" }
        },
        "factRefs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^fact-(?=[0-9]*[1-9])[0-9]{6}(?![\\s\\S])" }
        },
        "observationRefs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^observation-(?:architecture|security)-(?=[0-9]*[1-9])[0-9]{3,6}(?![\\s\\S])"
          }
        }
      }
    }
  }
}
