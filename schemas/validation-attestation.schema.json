{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local Analysis Package Validation Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageSchemaVersion", "packageSha256", "builderVersion", "validatorVersion", "status", "checks"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "packageSchemaVersion": { "enum": ["1.0", "1.1", "1.2"] },
    "packageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])" },
    "builderVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])" },
    "validatorVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])" },
    "status": { "const": "Passed" },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "references", "prohibitedValues"],
      "properties": {
        "contract": { "const": "Passed" },
        "references": { "const": "Passed" },
        "prohibitedValues": { "const": "Passed" }
      }
    }
  }
}
