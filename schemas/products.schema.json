{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Optional restricted product governance model",
  "type": "array",
  "maxItems": 20000,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["productId", "productFound", "hasDescription", "hasOwner", "isExternal", "approvalRequired", "modelStatus", "missingInputs"],
    "properties": {
      "productId": { "type": "string", "minLength": 1 },
      "productFound": { "type": "boolean" },
      "hasDescription": { "type": ["boolean", "null"] },
      "hasOwner": { "type": ["boolean", "null"] },
      "isExternal": { "type": ["boolean", "null"] },
      "approvalRequired": { "type": ["boolean", "null"] },
      "modelStatus": { "enum": ["Complete", "Partial"] },
      "missingInputs": { "type": "array", "uniqueItems": true, "items": { "enum": ["product", "ownerIntent", "externalIntent", "approval"] } }
    }
  }
}
