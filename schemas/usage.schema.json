{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "sourceSha256", "startUtc", "endUtc", "modelStatus", "missingInputs", "rows", "topApis"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "startUtc": { "type": ["string", "null"], "format": "date-time" },
    "endUtc": { "type": "string", "format": "date-time" },
    "modelStatus": { "enum": ["Complete", "Partial"] },
    "missingInputs": { "$ref": "#/definitions/gaps" },
    "rows": {
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["period", "apiId", "calls", "modelStatus", "missingInputs"],
        "properties": {
          "period": { "type": "string", "format": "date" },
          "apiId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "calls": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
          "modelStatus": { "enum": ["Complete", "Partial"] },
          "missingInputs": { "$ref": "#/definitions/gaps" }
        }
      }
    },
    "topApis": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["apiId", "calls"],
        "properties": {
          "apiId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "calls": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    }
  },
  "definitions": {
    "gaps": { "type": "array", "uniqueItems": true, "items": { "enum": ["usage", "usageCoverage", "workspaceOverlap", "partialMonth"] } }
  }
}
