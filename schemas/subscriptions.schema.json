{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/apim-assessment/schemas/subscriptions.schema.json",
  "title": "APIM Assessment Subscription Model",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "subscriptionId",
      "displayName",
      "scopeType",
      "scopeTarget",
      "state",
      "ownerType",
      "createdDate",
      "expirationDate",
      "allowTracing",
      "calls90d",
      "lastUsed",
      "isBuiltInMaster",
      "flags",
      "modelStatus",
      "missingInputs"
    ],
    "properties": {
      "subscriptionId": {
        "type": "string",
        "minLength": 1
      },
      "displayName": {
        "type": ["string", "null"],
        "minLength": 1
      },
      "scopeType": {
        "enum": [
          "AllApis",
          "Product",
          "Api"
        ]
      },
      "scopeTarget": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "state": {
        "enum": [
          "active",
          "suspended",
          "submitted",
          "rejected",
          "cancelled",
          "expired"
        ]
      },
      "ownerType": {
        "enum": [
          "BuiltIn",
          "User",
          "None",
          "Unknown"
        ]
      },
      "createdDate": {
        "type": ["string", "null"],
        "format": "date-time"
      },
      "expirationDate": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "allowTracing": {
        "type": ["boolean", "null"]
      },
      "calls90d": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "lastUsed": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "isBuiltInMaster": {
        "type": "boolean"
      },
      "flags": {
        "type": "array",
        "items": {
          "enum": [
            "AllApis",
            "AllowTracing",
            "BuiltInMaster",
            "NoExpiration",
            "OwnerMissing"
          ]
        },
        "uniqueItems": true
      },
      "modelStatus": {
        "enum": [
          "Complete",
          "Partial"
        ]
      },
      "missingInputs": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    }
  }
}
