{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Operator-owned APIM Broker Startup",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "restrictedRoot", "analysisRoot", "privateStagingRoot", "visibleRoots", "visibleRootsComplete", "exclusiveFilesystem", "approved", "aliases", "savedRuns"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "restrictedRoot": { "type": "string", "minLength": 1 },
    "analysisRoot": { "type": "string", "minLength": 1 },
    "privateStagingRoot": { "type": "string", "minLength": 1 },
    "visibleRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "visibleRootsComplete": { "const": true },
    "exclusiveFilesystem": { "const": true },
    "approved": { "const": true },
    "aliases": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["alias", "configPath", "environments"],
        "properties": {
          "alias": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "configPath": { "type": "string", "minLength": 1 },
          "environments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,31}$" } }
        }
      }
    },
    "savedRuns": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["runId", "relativePath"],
        "properties": {
          "runId": { "type": "string", "pattern": "^run-[a-f0-9]{32}$" },
          "relativePath": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" }
        }
      }
    }
  }
}
