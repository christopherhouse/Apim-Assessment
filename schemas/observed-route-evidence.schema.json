{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "workspaces"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "enum": ["appgwByListener", "appgwNonEdge", "directNonAppGw", "headersLogged"] },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["workspaceId", "schema", "status", "reason", "requestedStartUtc", "startUtc", "endUtc", "retentionDays", "isCapped", "rows"],
        "properties": {
          "workspaceId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "schema": { "enum": ["ResourceSpecific", "Legacy", "Mixed", "None"] },
          "status": { "enum": ["Completed", "Partial", "Failed", "Skipped"] },
          "reason": { "enum": ["None", "Unconfigured", "OptOut", "Unavailable", "Conflicting"] },
          "requestedStartUtc": { "type": "string", "format": "date-time" },
          "startUtc": { "type": "string", "format": "date-time" },
          "endUtc": { "type": "string", "format": "date-time" },
          "retentionDays": { "type": ["integer", "null"], "minimum": 1, "maximum": 3650 },
          "isCapped": { "type": "boolean" },
          "rows": { "type": "array" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "enum": ["Failed", "Skipped"] } } },
            "then": { "properties": { "rows": { "maxItems": 0 } } }
          },
          {
            "if": { "properties": { "status": { "const": "Completed" } } },
            "then": { "properties": { "reason": { "const": "None" }, "schema": { "enum": ["ResourceSpecific", "Legacy"] } } }
          },
          {
            "if": { "properties": { "status": { "const": "Skipped" } } },
            "then": { "properties": { "reason": { "enum": ["OptOut", "Unconfigured"] } } }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "enum": ["appgwByListener", "appgwNonEdge"] } } },
      "then": { "properties": { "workspaces": { "items": { "properties": { "rows": { "items": { "$ref": "#/$defs/listener" } } } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "appgwNonEdge" } } },
      "then": { "properties": { "workspaces": { "items": { "properties": { "rows": { "items": { "required": ["clientClass"] } } } } } } },
      "else": { "properties": { "workspaces": { "items": { "properties": { "rows": { "items": { "not": { "required": ["clientClass"] } } } } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "directNonAppGw" } } },
      "then": { "properties": { "workspaces": { "items": { "properties": { "rows": { "items": { "$ref": "#/$defs/direct" } } } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "headersLogged" } } },
      "then": { "properties": { "workspaces": { "items": { "properties": { "rows": { "items": { "$ref": "#/$defs/headers" }, "maxItems": 1 } } } } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "listener": {
      "type": "object", "additionalProperties": false,
      "required": ["gatewayId", "listener", "rule", "host", "calls", "clientCount"],
      "properties": {
        "gatewayId": { "type": "string", "pattern": "^/subscriptions/[0-9a-f-]{36}/resourcegroups/[^/]+/providers/microsoft\\.network/applicationgateways/[^/?#]+$" },
        "listener": { "$ref": "#/$defs/id" },
        "rule": { "$ref": "#/$defs/id" },
        "host": { "$ref": "#/$defs/id" },
        "clientClass": { "enum": ["NonEdge", "Unknown"] },
        "calls": { "$ref": "#/$defs/count" },
        "clientCount": { "$ref": "#/$defs/count" }
      }
    },
    "direct": {
      "type": "object", "additionalProperties": false, "required": ["apiId", "calls"],
      "properties": { "apiId": { "$ref": "#/$defs/id" }, "calls": { "$ref": "#/$defs/count" } }
    },
    "headers": {
      "type": "object", "additionalProperties": false,
      "required": ["calls", "headersObserved", "xForwardedForCalls", "cfConnectingIpCalls"],
      "properties": {
        "calls": { "$ref": "#/$defs/count" },
        "headersObserved": { "$ref": "#/$defs/count" },
        "xForwardedForCalls": { "$ref": "#/$defs/count" },
        "cfConnectingIpCalls": { "$ref": "#/$defs/count" }
      }
    }
  }
}
