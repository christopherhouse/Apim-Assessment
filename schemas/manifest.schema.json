{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/apim-assessment/schemas/manifest.schema.json",
  "title": "APIM Assessment Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "customer",
    "environment",
    "runId",
    "startedUtc",
    "completedUtc",
    "operator",
    "tenantId",
    "subscriptionId",
    "apim",
    "windows",
    "edge",
    "scoring",
    "stages",
    "collectors",
    "modelSafe",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "enum": ["1.1", "1.2"]
    },
    "toolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "customer": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "startedUtc": {
      "type": "string",
      "format": "date-time"
    },
    "completedUtc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "subscriptionId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "apim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "apiVersion"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "pattern": "^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/Microsoft\\.ApiManagement/service/[^/]+$"
        },
        "apiVersion": {
          "const": "2024-05-01"
        }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usageDays",
        "securityLogDays",
        "costMonths"
      ],
      "properties": {
        "usageDays": {
          "type": "integer",
          "minimum": 1
        },
        "securityLogDays": {
          "type": "integer",
          "minimum": 1
        },
        "costMonths": {
          "type": "integer",
          "minimum": 1
        },
        "metricDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      }
    },
    "evidenceWindows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind", "target", "schema", "requestedStartUtc", "startUtc",
          "endUtc", "retentionDays", "isCapped", "status", "reason"
        ],
        "properties": {
          "kind": { "enum": ["Usage", "Security", "Metric", "Cost", "Ingestion", "AppGateway"] },
          "target": { "type": "string", "minLength": 1 },
          "schema": { "enum": ["ResourceSpecific", "Legacy", "Mixed", "None", "NotApplicable"] },
          "requestedStartUtc": { "type": "string", "format": "date-time" },
          "startUtc": { "type": "string", "format": "date-time" },
          "endUtc": { "type": "string", "format": "date-time" },
          "retentionDays": { "type": ["integer", "null"], "minimum": 1, "maximum": 3650 },
          "isCapped": { "type": "boolean" },
          "status": { "enum": ["Completed", "Partial", "Failed", "Skipped"] },
          "reason": { "enum": ["None", "Unconfigured", "OptOut", "Unavailable", "Conflicting"] }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "mode"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "AssumedReachable",
            "Collected"
          ]
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "exposure",
        "usage"
      ],
      "properties": {
        "severity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "high",
            "medium",
            "low",
            "info"
          ],
          "properties": {
            "high": {
              "$ref": "#/definitions/scoringWeight"
            },
            "medium": {
              "$ref": "#/definitions/scoringWeight"
            },
            "low": {
              "$ref": "#/definitions/scoringWeight"
            },
            "info": {
              "$ref": "#/definitions/scoringWeight"
            }
          }
        },
        "exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directPublic",
            "externalInUse",
            "externalUnintended",
            "restricted",
            "internal",
            "platform",
            "unknown"
          ],
          "properties": {
            "directPublic": {
              "$ref": "#/definitions/scoringWeight"
            },
            "externalInUse": {
              "$ref": "#/definitions/scoringWeight"
            },
            "externalUnintended": {
              "$ref": "#/definitions/scoringWeight"
            },
            "restricted": {
              "$ref": "#/definitions/scoringWeight"
            },
            "internal": {
              "$ref": "#/definitions/scoringWeight"
            },
            "platform": {
              "$ref": "#/definitions/scoringWeight"
            },
            "unknown": {
              "$ref": "#/definitions/scoringWeight"
            }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inUse",
            "unused",
            "notApplicable"
          ],
          "properties": {
            "inUse": {
              "$ref": "#/definitions/scoringWeight"
            },
            "unused": {
              "$ref": "#/definitions/scoringWeight"
            },
            "notApplicable": {
              "$ref": "#/definitions/scoringWeight"
            }
          }
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collect",
        "analyze",
        "report"
      ],
      "properties": {
        "collect": {
          "$ref": "#/definitions/stageStatus"
        },
        "analyze": {
          "$ref": "#/definitions/stageStatus"
        },
        "report": {
          "$ref": "#/definitions/stageStatus"
        }
      }
    },
    "collectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "items",
          "errors",
          "durationSec"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/definitions/stageStatus"
          },
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          },
          "durationSec": {
            "type": "number",
            "minimum": 0
          },
          "files": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._~%-]+(?:/[A-Za-z0-9._~%-]+)*$"
            }
          }
        }
      }
    },
    "modelSafe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "validation",
        "promotion",
        "packageSha256"
      ],
      "properties": {
        "build": {
          "$ref": "#/definitions/modelSafeStatus"
        },
        "validation": {
          "enum": [
            "NotRun",
            "Passed",
            "Failed",
            "Skipped"
          ]
        },
        "promotion": {
          "$ref": "#/definitions/modelSafeStatus"
        },
        "packageSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": "1.2" } } },
      "then": {
        "required": ["evidenceWindows"],
        "properties": { "windows": { "required": ["metricDays"] } }
      },
      "else": {
        "not": { "required": ["evidenceWindows"] },
        "properties": { "windows": { "not": { "required": ["metricDays"] } } }
      }
    }
  ],
  "definitions": {
    "stageStatus": {
      "enum": [
        "NotStarted",
        "InProgress",
        "Completed",
        "Partial",
        "Failed",
        "Skipped"
      ]
    },
    "modelSafeStatus": {
      "enum": [
        "NotStarted",
        "Completed",
        "Failed",
        "Skipped"
      ]
    },
    "scoringWeight": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
