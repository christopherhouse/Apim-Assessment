{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Restricted workbook tracking projection",
  "type": "array",
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["kind", "key", "ruleId", "evaluation", "owner", "status", "targetDate", "notes"],
    "properties": {
      "kind": { "enum": ["Action", "Finding"] },
      "key": { "type": "string", "minLength": 1 },
      "ruleId": { "type": "string", "pattern": "^APIM-[A-Z]+-[0-9]{3}$" },
      "evaluation": { "enum": ["Evaluated", "NotEvaluated"] },
      "owner": { "type": ["string", "null"], "maxLength": 32767 },
      "status": { "enum": ["Open", "In progress", "Done", "Accepted risk", "Not applicable", null] },
      "targetDate": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
      "notes": { "type": ["string", "null"], "maxLength": 32767 }
    }
  }
}
