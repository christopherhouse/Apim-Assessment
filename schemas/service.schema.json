{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/apim-assessment/schemas/service.schema.json",
  "title": "APIM Assessment Service Security Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skuName",
    "skuCapacity",
    "zones",
    "platformVersion",
    "hostnameCertificateExpirations",
    "legacyTlsEnabled",
    "enabledLegacyTlsControls",
    "minApiVersion",
    "managedIdentity",
    "modelStatus",
    "missingInputs"
  ],
  "properties": {
    "skuName": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "skuCapacity": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "platformVersion": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "hostnameCertificateExpirations": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date-time"
      },
      "uniqueItems": true
    },
    "legacyTlsEnabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "enabledLegacyTlsControls": {
      "type": "array",
      "items": {
        "enum": [
          "GatewayTls10",
          "GatewayTls11",
          "GatewayTripleDes168",
          "BackendTls10",
          "BackendTls11"
        ]
      },
      "uniqueItems": true
    },
    "minApiVersion": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "managedIdentity": {
      "enum": [
        "None",
        "SystemAssigned",
        "UserAssigned",
        "SystemAssignedUserAssigned"
      ]
    },
    "modelStatus": {
      "enum": [
        "Complete",
        "Partial"
      ]
    },
    "missingInputs": {
      "type": "array",
      "items": {
        "enum": [
          "legacyTlsControls",
          "hostnameCertificateExpirations",
          "platformVersion",
          "skuCapacity",
          "skuName"
        ]
      },
      "uniqueItems": true
    }
  }
}
