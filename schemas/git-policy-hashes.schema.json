{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Committed Git policy hash inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commitSha", "scopeTypes", "policies"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "commitSha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])" },
    "scopeTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["Global", "Product", "Api", "Operation", "Fragment"] }
    },
    "policies": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scopeType", "scope", "sha256"],
        "properties": {
          "scopeType": { "enum": ["Global", "Product", "Api", "Operation", "Fragment"] },
          "scope": { "type": "string", "minLength": 1, "maxLength": 513 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])" }
        },
        "allOf": [
          {
            "if": { "properties": { "scopeType": { "const": "Global" } } },
            "then": { "properties": { "scope": { "const": "global" } } }
          },
          {
            "if": { "properties": { "scopeType": { "const": "Operation" } } },
            "then": { "properties": { "scope": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}\\|[A-Za-z0-9][A-Za-z0-9._-]{0,255}(?![\\s\\S])" } } }
          },
          {
            "if": { "properties": { "scopeType": { "enum": ["Api", "Product", "Fragment"] } } },
            "then": { "properties": { "scope": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}(?![\\s\\S])" } } }
          }
        ]
      }
    }
  }
}
