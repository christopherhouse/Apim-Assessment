{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "workspaces"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "enum": ["usageByApi", "usageByRoute", "usageMonthly", "tls", "noSubscriptionCalls", "laIngestion"] },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workspaceId", "status", "rows"],
        "properties": {
          "workspaceId": { "$ref": "#/$defs/workspaceId" },
          "status": { "enum": ["Completed", "Partial", "Failed"] },
          "rows": { "type": "array" }
        },
        "allOf": [{
          "if": { "properties": { "status": { "const": "Failed" } } },
          "then": { "properties": { "rows": { "maxItems": 0 } } }
        }]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "enum": ["usageByApi", "usageByRoute"] } } },
      "then": { "properties": { "workspaces": { "items": { "properties": { "rows": { "items": { "$ref": "#/$defs/apiAggregate" } } } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "usageByRoute" } } },
      "then": { "properties": { "workspaces": { "items": { "properties": { "rows": { "items": { "required": ["route"] } } } } } } },
      "else": { "properties": { "workspaces": { "items": { "properties": { "rows": { "items": { "not": { "required": ["route"] } } } } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "usageMonthly" } } },
      "then": { "properties": { "workspaces": { "items": { "properties": { "rows": { "items": { "$ref": "#/$defs/monthly" } } } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "tls" } } },
      "then": { "properties": { "workspaces": { "items": { "properties": { "rows": { "items": { "$ref": "#/$defs/tls" } } } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "noSubscriptionCalls" } } },
      "then": { "properties": { "workspaces": { "items": { "properties": { "rows": { "items": { "$ref": "#/$defs/noSubscription" } } } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "laIngestion" } } },
      "then": { "properties": { "workspaces": { "items": { "properties": { "rows": { "items": { "$ref": "#/$defs/ingestion" } } } } } } }
    }
  ],
  "$defs": {
    "workspaceId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "id": { "type": "string", "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "latency": { "type": ["number", "null"], "minimum": 0 },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "apiAggregate": {
      "type": "object", "additionalProperties": false,
      "required": ["apiId", "operationId", "productId", "calls", "error4xx", "error5xx", "unauthorized", "subscriptionCount", "totalTimeP50", "totalTimeP95", "backendTimeP95", "lastCall"],
      "properties": {
        "apiId": { "$ref": "#/$defs/id" },
        "operationId": { "$ref": "#/$defs/id" },
        "productId": { "$ref": "#/$defs/id" },
        "route": { "enum": ["ViaAppGw", "Internal", "Other", "Unknown"] },
        "calls": { "$ref": "#/$defs/count" },
        "error4xx": { "$ref": "#/$defs/count" },
        "error5xx": { "$ref": "#/$defs/count" },
        "unauthorized": { "$ref": "#/$defs/count" },
        "subscriptionCount": { "$ref": "#/$defs/count" },
        "totalTimeP50": { "$ref": "#/$defs/latency" },
        "totalTimeP95": { "$ref": "#/$defs/latency" },
        "backendTimeP95": { "$ref": "#/$defs/latency" },
        "lastCall": { "type": "string", "format": "date-time" }
      }
    },
    "monthly": {
      "type": "object", "additionalProperties": false, "required": ["apiId", "month", "calls"],
      "properties": { "apiId": { "$ref": "#/$defs/id" }, "month": { "$ref": "#/$defs/date" }, "calls": { "$ref": "#/$defs/count" } }
    },
    "tls": {
      "type": "object", "additionalProperties": false, "required": ["apiId", "tlsVersion", "calls"],
      "properties": {
        "apiId": { "$ref": "#/$defs/id" },
        "tlsVersion": { "enum": ["TLSv1", "TLSv1.0", "TLSv1.1", "TLSv1.2", "TLSv1.3", "1.0", "1.1", "1.2", "1.3", "Unknown"] },
        "calls": { "$ref": "#/$defs/count" }
      }
    },
    "noSubscription": {
      "type": "object", "additionalProperties": false, "required": ["apiId", "calls"],
      "properties": { "apiId": { "$ref": "#/$defs/id" }, "calls": { "$ref": "#/$defs/count" } }
    },
    "ingestion": {
      "type": "object", "additionalProperties": false, "required": ["dataType", "day", "gb"],
      "properties": {
        "dataType": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$" },
        "day": { "$ref": "#/$defs/date" },
        "gb": { "type": "number", "minimum": 0 }
      }
    }
  }
}
