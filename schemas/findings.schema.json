{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/apim-assessment/schemas/findings.schema.json",
  "title": "APIM Assessment Findings",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "findingKey", "ruleId", "title", "pillar", "mcsb", "severity", "scope",
      "resource", "exposure", "usage", "priorityScore", "evidence",
      "evidenceText", "recommendation", "effort", "sourceFiles", "status",
      "evaluation"
    ],
    "properties": {
      "findingKey": { "type": "string", "pattern": "^APIM-[A-Z]+-[0-9]{3}\\|[^|]+\\|.+$" },
      "ruleId": { "type": "string", "pattern": "^APIM-[A-Z]+-[0-9]{3}$" },
      "title": { "type": "string", "minLength": 1 },
      "pillar": {
        "enum": [
          "Security", "Reliability", "OperationalExcellence",
          "CostOptimization", "PerformanceEfficiency"
        ]
      },
      "mcsb": { "type": "string", "minLength": 1 },
      "severity": { "enum": ["High", "Medium", "Low", "Info"] },
      "scope": { "type": "string", "minLength": 1 },
      "resource": { "type": "string", "minLength": 1 },
      "exposure": {
        "enum": [
          "DirectPublic", "ExternalInUse", "ExternalUnintended",
          "Restricted", "Internal", "Platform", "Unknown"
        ]
      },
      "usage": { "enum": ["InUse", "Unused", "NotApplicable", null] },
      "priorityScore": { "type": "number", "minimum": 0 },
      "evidence": { "type": "object" },
      "evidenceText": { "type": "string" },
      "recommendation": { "type": "string", "minLength": 1 },
      "effort": { "enum": ["S", "M", "L"] },
      "sourceFiles": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      },
      "status": { "const": "Open" },
      "evaluation": { "enum": ["Evaluated", "NotEvaluated"] }
    },
    "allOf": [
      {
        "if": {
          "properties": { "evaluation": { "const": "NotEvaluated" } }
        },
        "then": {
          "properties": {
            "severity": { "const": "Info" },
            "evidence": {
              "required": ["missingInputs"],
              "properties": {
                "missingInputs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^model/[A-Za-z]+\\.json$" }
                }
              }
            }
          }
        }
      }
    ]
  }
}
