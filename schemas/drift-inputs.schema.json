{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "current", "sources"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "current": { "$ref": "#/definitions/snapshot" },
    "sources": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/definitions/snapshot" } }
  },
  "definitions": {
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "environment", "runId", "resourceId", "complete", "scopeTypes", "apiIds", "policies"],
      "properties": {
        "kind": { "enum": ["Git", "Environment"] },
        "environment": { "type": "string", "minLength": 1, "maxLength": 128 },
        "runId": { "type": ["string", "null"] },
        "resourceId": { "type": ["string", "null"] },
        "complete": { "type": "boolean" },
        "scopeTypes": { "type": "array", "uniqueItems": true, "items": { "enum": ["Global", "Product", "Api", "Operation", "Fragment"] } },
        "apiIds": { "type": "array", "uniqueItems": true, "maxItems": 10000, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "policies": {
          "type": "array", "maxItems": 10000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["scopeType", "scope", "exists", "sha256"],
            "properties": {
              "scopeType": { "enum": ["Global", "Product", "Api", "Operation", "Fragment"] },
              "scope": { "type": "string", "minLength": 1, "maxLength": 512 },
              "exists": { "type": "boolean" },
              "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  }
}
