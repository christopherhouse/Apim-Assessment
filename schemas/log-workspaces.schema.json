{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaces"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["workspaceId", "resourceId", "retentionDays", "tables", "schema", "mixed"],
        "properties": {
          "workspaceId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "resourceId": { "type": "string", "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/Microsoft\\.OperationalInsights/workspaces/[^/?#]+$" },
          "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
          "schema": { "enum": ["ResourceSpecific", "Legacy", "None"] },
          "mixed": { "type": "boolean" },
          "tables": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["name", "retentionDays"],
              "properties": {
                "name": { "enum": ["ApiManagementGatewayLogs", "AzureDiagnostics", "Usage", "AGWAccessLogs"] },
                "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
              }
            }
          }
        }
      }
    }
  }
}
