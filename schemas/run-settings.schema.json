{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "toolVersion", "appGateways", "appGwSubnetCidrs", "certExpiryDays", "criticalBackendIds", "approvedPlainHttpBackendIds", "approvedPlainHttpOperationKeys", "usageBuckets"],
  "properties": {
    "schemaVersion": { "enum": ["1.0", "1.1", "1.2"] },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceIds", "costScopes", "logicAppResourceGroups", "internalCidrs", "skipLogs", "skipCost", "unusedDays"],
      "properties": {
        "workspaceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
        },
        "costScopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^/subscriptions/[0-9a-f-]{36}(?:/resourcegroups/[a-z0-9._()-]+)?$" } },
        "logicAppResourceGroups": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 90 } },
        "internalCidrs": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$" }
        },
        "skipLogs": { "type": "boolean" },
        "skipCost": { "type": "boolean" },
        "unusedDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "trustedEdgeRanges": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$" }
        }
      }
    },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "toolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "appGateways": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "resourceGroup"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "resourceGroup": { "type": "string", "minLength": 1 }
        }
      }
    },
    "appGwSubnetCidrs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$" }
    },
    "certExpiryDays": { "type": "number", "minimum": 0 },
    "criticalBackendIds": { "$ref": "#/$defs/ids" },
    "approvedPlainHttpBackendIds": { "$ref": "#/$defs/ids" },
    "approvedPlainHttpOperationKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$" }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "products": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["productId", "hasOwner", "isExternal"],
            "properties": {
              "productId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
              "hasOwner": { "type": "boolean" },
              "isExternal": { "type": "boolean" }
            }
          }
        },
        "criticalApiIds": { "$ref": "#/$defs/ids", "maxItems": 10000 }
      }
    },
    "openApiQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errorPenalty", "warningPenalty"],
      "properties": {
        "errorPenalty": { "type": "integer", "minimum": 0, "maximum": 100 },
        "warningPenalty": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "portalProductVisibility": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "isPublic", "intendedGroupIds"],
        "properties": {
          "productId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "isPublic": { "type": "boolean" },
          "intendedGroupIds": { "$ref": "#/$defs/ids" }
        }
      }
    },
    "usageBuckets": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "type": "number", "minimum": 0 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "enum": ["1.1", "1.2"] } } },
      "then": { "required": ["telemetry"] },
      "else": { "not": { "required": ["telemetry"] } }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": "1.2" } } },
      "then": { "properties": { "telemetry": { "required": ["trustedEdgeRanges"] } } },
      "else": { "properties": { "telemetry": { "not": { "required": ["trustedEdgeRanges"] } } } }
    }
  ],
  "$defs": {
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
    }
  }
}
