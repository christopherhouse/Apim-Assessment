{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/apim-assessment/schemas/policyMatrix.schema.json",
  "title": "APIM Assessment Policy Matrix",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "apiId",
      "evaluationStatus",
      "callerAuth",
      "rateLimit",
      "ipFilter",
      "corsSafe",
      "backendAuth",
      "noHardcodedSecret",
      "basePresent",
      "noMockTrace",
      "modelStatus",
      "missingInputs"
    ],
    "properties": {
      "apiId": {
        "type": "string",
        "minLength": 1
      },
      "evaluationStatus": {
        "enum": [
          "Complete",
          "Partial"
        ]
      },
      "callerAuth": {
        "$ref": "#/definitions/controlStatus"
      },
      "rateLimit": {
        "$ref": "#/definitions/controlStatus"
      },
      "ipFilter": {
        "$ref": "#/definitions/controlStatus"
      },
      "corsSafe": {
        "$ref": "#/definitions/controlStatus"
      },
      "backendAuth": {
        "$ref": "#/definitions/controlStatus"
      },
      "noHardcodedSecret": {
        "$ref": "#/definitions/controlStatus"
      },
      "basePresent": {
        "$ref": "#/definitions/controlStatus"
      },
      "noMockTrace": {
        "$ref": "#/definitions/controlStatus"
      },
      "modelStatus": {
        "enum": [
          "Complete",
          "Partial"
        ]
      },
      "missingInputs": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    }
  },
  "definitions": {
    "controlStatus": {
      "enum": [
        "Pass",
        "Fail",
        "NA"
      ]
    }
  }
}
