{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "sourceSha256", "modelStatus", "missingInputs", "percentileMethod", "units", "capacityAvg", "capacityMax", "capacityP95", "sampleCount", "expectedSamples", "rows"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelStatus": { "enum": ["Complete", "Partial"] },
    "missingInputs": { "type": "array", "uniqueItems": true, "items": { "enum": ["capacity", "capacityCoverage", "units"] } },
    "percentileMethod": { "const": "NearestRankHourlyAverage" },
    "units": { "type": ["integer", "null"], "minimum": 0 },
    "capacityAvg": { "type": ["number", "null"], "minimum": 0 },
    "capacityMax": { "type": ["number", "null"], "minimum": 0 },
    "capacityP95": { "type": ["number", "null"], "minimum": 0 },
    "sampleCount": { "type": "integer", "minimum": 0 },
    "expectedSamples": { "type": "integer", "minimum": 1 },
    "rows": {
      "type": "array", "maxItems": 3651,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["day", "capacityAvg", "capacityMax", "capacityP95", "sampleCount"],
        "properties": {
          "day": { "type": "string", "format": "date" },
          "capacityAvg": { "type": ["number", "null"], "minimum": 0 },
          "capacityMax": { "type": ["number", "null"], "minimum": 0 },
          "capacityP95": { "type": ["number", "null"], "minimum": 0 },
          "sampleCount": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
