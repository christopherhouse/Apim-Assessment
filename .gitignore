# Assessment data and customer configuration never belong in source control.
/runs/
/model-safe/
/config/*
!/config/sample.psd1
!/config/README.md

# Local validation and release output.
/artifacts/
/dist/
/coverage/
*.log

# Local tooling and editor state.
/.tools/
/.vscode/
/.idea/
.DS_Store
Thumbs.db
*.tmp
*.swp

# Lab handoff files are private; only fixed synthetic/config-schema JSON is tracked.
/infra/live-validation-lab/*.json
!/infra/live-validation-lab/bicepconfig.json
!/infra/live-validation-lab/bootstrap.config.schema.json
!/infra/live-validation-lab/bootstrap.sample.json
!/infra/live-validation-lab/foundation.config.schema.json
!/infra/live-validation-lab/foundation.sample.json
!/infra/live-validation-lab/worker.config.schema.json
!/infra/live-validation-lab/worker.sample.json
!/infra/live-validation-lab/acme.config.schema.json
!/infra/live-validation-lab/acme.sample.json
/infra/live-validation-lab/*.bicepparam
!/infra/live-validation-lab/foundation.synthetic.bicepparam
!/infra/live-validation-lab/worker.synthetic.bicepparam
/infra/live-validation-lab/worker/*.json
/infra/live-validation-lab/worker/*.pem
/infra/live-validation-lab/worker/*.key
/infra/live-validation-lab/worker/*.pfx
/infra/live-validation-lab/worker/*.p12
!/infra/live-validation-lab/worker/global.json
!/infra/live-validation-lab/worker/packages.lock.json
!/infra/live-validation-lab/worker/config.schema.json
!/infra/live-validation-lab/worker/config.sample.json
!/infra/live-validation-lab/worker/job.schema.json
!/infra/live-validation-lab/worker/job.sample.json
/infra/live-validation-lab/worker/bin/
/infra/live-validation-lab/worker/obj/
/tests/lab-worker/bin/
/tests/lab-worker/obj/
