{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private lab worker VM configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "labId", "location", "vnetName", "workerVmName", "workerCidr", "workerPrivateIp", "sshPublicKey", "vmSize", "ubuntuImageVersion", "availabilityZone"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "labId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,39}$" },
    "location": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,39}$" },
    "vnetName": { "$ref": "#/$defs/name" },
    "workerVmName": { "$ref": "#/$defs/name" },
    "workerCidr": { "type": "string", "pattern": "^[0-9.]+/[0-9]{1,2}$" },
    "workerPrivateIp": { "type": "string", "pattern": "^[0-9.]+$" },
    "sshPublicKey": { "type": "string", "minLength": 380, "maxLength": 1500, "pattern": "^ssh-rsa [A-Za-z0-9+/]+={0,2}(?: [A-Za-z0-9_-]{1,40})?$" },
    "vmSize": { "enum": ["Standard_B2ls_v2", "Standard_B2s"] },
    "ubuntuImageVersion": { "type": "string", "maxLength": 40, "pattern": "^(?:latest|[0-9]+\\.[0-9]+\\.[0-9]+)$" },
    "availabilityZone": { "enum": [1, 2, 3] }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$" }
  }
}
