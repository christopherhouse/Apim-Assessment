{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private synthetic lab API parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "apimName", "tenantId", "frontendResourceClientId",
    "backendAudienceClientId", "workerClientId", "backendOrigin",
    "gatewayCidr", "workerCidr", "workerPrivateIp"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "apimName": { "type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$" },
    "tenantId": { "$ref": "#/$defs/id" },
    "frontendResourceClientId": { "$ref": "#/$defs/id" },
    "backendAudienceClientId": { "$ref": "#/$defs/id" },
    "workerClientId": { "$ref": "#/$defs/id" },
    "backendOrigin": {
      "type": "string", "maxLength": 261,
      "pattern": "^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
    },
    "gatewayCidr": { "type": "string", "maxLength": 18 },
    "workerCidr": { "type": "string", "maxLength": 18 },
    "workerPrivateIp": { "type": "string", "maxLength": 15 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
  }
}
