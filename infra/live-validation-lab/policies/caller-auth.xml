<fragment>
  <validate-azure-ad-token tenant-id="__TENANT_ID__" header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized" output-token-variable-name="labCaller">
    <client-application-ids>
      <application-id>__WORKER_ID__</application-id>
    </client-application-ids>
    <audiences>
      <audience>__FRONTEND_ID__</audience>
    </audiences>
    <required-claims>
      <claim name="tid" match="all"><value>__TENANT_ID__</value></claim>
      <claim name="ver" match="all"><value>2.0</value></claim>
      <claim name="azp" match="all"><value>__WORKER_ID__</value></claim>
      <claim name="roles" match="all"><value>Lab.Frontend.Invoke</value></claim>
    </required-claims>
  </validate-azure-ad-token>
  <choose>
    <when condition='@(((Jwt)context.Variables["labCaller"]).Claims.ContainsKey("scp"))'>
      <return-response><set-status code="403" reason="Forbidden" /></return-response>
    </when>
  </choose>
</fragment>
