<policies>
  <inbound>
    <base />
    __PRIVATE_GUARD__
    <choose>
      <when condition='@(context.Product == null || !(__PRODUCT_PREDICATE__) || !context.Variables.ContainsKey("labProduct") || (string)context.Variables["labProduct"] != context.Product.Id)'>
        <return-response><set-status code="403" reason="Forbidden" /></return-response>
      </when>
    </choose>
    <set-backend-service backend-id="lab-__API_ID__" />
    <include-fragment fragment-id="lab-backend-auth" />
  </inbound>
  <backend><base /></backend>
  <outbound>
    <base />
    <set-header name="X-Lab-Api" exists-action="override"><value>__API_ID__</value></set-header>
    <set-header name="X-Lab-Policy" exists-action="override"><value>api</value></set-header>
  </outbound>
  <on-error><base /></on-error>
</policies>
